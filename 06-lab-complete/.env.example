# ============================================================
# Biến môi trường của agent. Dùng:  cp .env.example .env  rồi điền giá trị.
# File .env đã nằm trong .gitignore — KHÔNG commit secret thật.
# Trên Railway / Render: đặt các biến này trong mục Variables / Environment.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc. Tạo key ngẫu nhiên:  openssl rand -hex 32
AGENT_API_KEY=

# Redis — state dùng chung (rate limit, cost). Docker Compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
